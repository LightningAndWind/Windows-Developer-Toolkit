// 左侧竖向标签栏：分组 + 标签列表 + 新建入口 + 底部操作条。
// 全部使用 Theme（= 系统 Fluent 配色），行高与内边距统一，避免错位。
import { ListView } from "std-widgets.slint";
import { Theme } from "../globals/Theme.slint";
import { AppState, TabItemData, SidebarRow } from "../globals/AppState.slint";
import { AppButton, AppIconButton, Label, HLine } from "../components/Controls.slint";

component TabRow inherits Rectangle {
    in property <TabItemData> data;
    in property <int> indent: 0;
    in property <int> color-index: 0;
    in property <bool> active;

    height: 30px;
    border-radius: Theme.radius;
    background: active ? Theme.accent-soft : (ta.has-hover ? Theme.hover : transparent);

    ta := TouchArea {
        property <PointerEventButton> down-btn: PointerEventButton.left;
        property <length> press-x;
        property <length> press-y;

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                down-btn = e.button;
                press-x = self.mouse-x;
                press-y = self.mouse-y;
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                AppState.context-x = self.absolute-position.x + self.mouse-x;
                AppState.context-y = self.absolute-position.y + self.mouse-y;
                AppState.tab-context-tab = data.id;
                AppState.tab-context-visible = true;
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                if (AppState.drag-active && AppState.drag-tab-id == data.id) {
                    AppState.tab-dropped();
                }
            }
            if (e.kind == PointerEventKind.cancel) {
                AppState.drag-active = false;
                AppState.drag-hover-group = "";
            }
        }
        clicked => {
            if (down-btn == PointerEventButton.left) {
                AppState.select-tab(data.id);
            }
        }
        double-clicked => { AppState.rename-requested(data.id); }
        moved => {
            if (!AppState.drag-active && self.pressed
                && (Math.abs(self.mouse-x - press-x) > 6px || Math.abs(self.mouse-y - press-y) > 6px)) {
                AppState.drag-active = true;
                AppState.drag-tab-id = data.id;
                AppState.drag-tab-title = data.title;
                AppState.drag-tab-icon = data.icon;
                AppState.drag-hover-group = "";
            }
            if (AppState.drag-active && AppState.drag-tab-id == data.id) {
                AppState.drag-x = self.absolute-position.x + self.mouse-x;
                AppState.drag-y = self.absolute-position.y + self.mouse-y;
            }
        }
    }

    // 分组色条
    if data.group-id != "": Rectangle {
        x: 24px;
        y: (parent.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.group-color(root.color-index);
    }

    // 子项高度统一等于行高：布局的交叉轴不居中，只有撑满行高才能共用一条中线
    HorizontalLayout {
        padding-left: 8px + root.indent * 24px;
        padding-right: 4px;
        spacing: 6px;

        Text {
            text: root.data.icon;
            width: 16px;
            height: 30px;
            font-family: "Segoe MDL2 Assets";
            font-size: Theme.fs-small;
            color: root.active ? Theme.text : Theme.text-secondary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        Label {
            text: root.data.title;
            size: Theme.fs-small;
            height: 30px;
            horizontal-stretch: 1;
            color: root.active ? Theme.text : Theme.text-secondary;
        }

        if root.data.dirty: Rectangle {
            width: 6px;
            height: 30px;

            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                y: (parent.height - self.height) / 2;
                background: Theme.accent;
            }
        }

        Rectangle {
            width: 20px;
            height: 30px;

            Rectangle {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius;
                visible: close-ta.has-hover || root.active;
                background: close-ta.has-hover ? Theme.pressed : transparent;

                close-ta := TouchArea {
                    clicked => { AppState.close-tab(root.data.id); }
                }

                Text {
                    text: "\u{E711}";
                    font-family: "Segoe MDL2 Assets";
                    font-size: Theme.fs-caption;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component GroupHeader inherits Rectangle {
    in property <SidebarRow> data;

    property <bool> drop-hl: AppState.drag-active
        && AppState.drag-y >= self.absolute-position.y
        && AppState.drag-y < self.absolute-position.y + self.height;

    height: 28px;
    border-radius: Theme.radius;
    border-width: drop-hl ? 1px : 0px;
    border-color: Theme.accent;
    background: drop-hl
        ? Theme.accent-soft
        : Theme.group-color(root.data.color-index).transparentize(0.9);

    changed drop-hl => {
        if (self.drop-hl) {
            AppState.drag-hover-group = root.data.group-id;
        } else if (AppState.drag-hover-group == root.data.group-id) {
            AppState.drag-hover-group = "";
        }
    }

    ta := TouchArea {
        clicked => { AppState.toggle-group(root.data.group-id); }
    }

    // 同 TabRow：子项撑满 28px 行高，圆点 / 标题 / 计数 / 箭头共用中线
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 6px;

        Rectangle {
            width: 8px;
            height: 28px;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                y: (parent.height - self.height) / 2;
                background: Theme.group-color(root.data.color-index);
            }
        }

        Label {
            text: root.data.name;
            size: Theme.fs-small;
            height: 28px;
            strong: true;
            role: 1;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 18px;
            height: 28px;

            Rectangle {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius;
                visible: del-ta.has-hover;
                background: del-ta.has-hover ? Theme.danger-soft : transparent;

                del-ta := TouchArea {
                    clicked => { AppState.delete-group(root.data.group-id); }
                }

                Text {
                    text: "\u{E711}";
                    font-size: Theme.fs-caption;
                    font-family: "Segoe MDL2 Assets";
                    color: del-ta.has-hover ? Theme.danger : Theme.text-tertiary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: "\{root.data.group-count}";
            height: 28px;
            color: Theme.text-tertiary;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
        }

        Text {
            width: 14px;
            height: 28px;
            text: root.data.collapsed ? "\u{E76C}" : "\u{E70D}";
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            font-family: "Segoe MDL2 Assets";
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component TabSidebar inherits Rectangle {
    background: Theme.surface;

    VerticalLayout {
        spacing: 0;

        // 顶部：应用标识 + 新建标签
        Rectangle {
            height: 40px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 6px;
                cross-axis-alignment: center;

                Text {
                    text: "devkit";
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                AppIconButton {
                    icon: "\u{E710}";
                    box: 26px;
                    icon-size: 12px;
                    clicked => { AppState.new-tab(""); }
                }
            }
        }

        // 标签列表（分组头 + 成员）
        ListView {
            vertical-stretch: 1;
            x: 8px;
            width: parent.width - 16px;

            for row in AppState.sidebar-rows: Rectangle {
                width: parent.width;
                height: row.kind == 0 ? 28px : 30px;

                if row.kind == 0: GroupHeader { data: row; }
                if row.kind == 1: TabRow {
                    data: row.tab;
                    indent: row.group-id == "" ? 0 : 1;
                    color-index: row.color-index;
                    active: row.tab.id == AppState.active-id;
                }
            }
        }

        // 新建入口
        Rectangle {
            height: 40px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 8px;
                spacing: 6px;
                cross-axis-alignment: center;

                AppButton {
                    label: "新标签";
                    icon: "\u{E710}";
                    kind: 3;
                    horizontal-stretch: 1;
                    clicked => { AppState.new-tab(""); }
                }

                AppIconButton {
                    icon: "\u{E8F1}";
                    box: 30px;
                    icon-size: 13px;
                    clicked => { AppState.new-group(); }
                }
            }
        }

        // 底部操作条：设置 / 防休眠 / 外观
        Rectangle {
            height: 38px;

            HLine {}

            HorizontalLayout {
                height: 37px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                cross-axis-alignment: center;

                AppIconButton {
                    icon: "\u{E713}";
                    box: 28px;
                    icon-size: 14px;
                    clicked => { AppState.settings-opened(); }
                }
                AppIconButton {
                    icon: "\u{E823}";
                    box: 28px;
                    icon-size: 14px;
                    active: AppState.prevent-sleep;
                    clicked => { AppState.sleep-toggled(); }
                }
                AppIconButton {
                    icon: Theme.dark ? "\u{E708}" : "\u{E793}";
                    box: 28px;
                    icon-size: 14px;
                    clicked => { AppState.appearance-cycled(); }
                }

                Rectangle { horizontal-stretch: 1; }

                Label {
                    text: AppState.appearance-mode == 0 ? "跟随系统" : (AppState.appearance-mode == 1 ? "浅色" : "深色");
                    size: Theme.fs-caption;
                    role: 2;
                }
            }
        }
    }
}
