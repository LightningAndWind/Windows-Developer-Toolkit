// JSON 工具视图：工具栏（视图切换 / 格式化 / 压缩 / 排序 / 缩进 / 复制）
// + 文本编辑器或树形列表 + 底部状态栏（统计 / 错误）。
import { ListView, TextEdit, TabWidget } from "std-widgets.slint";
import { Theme } from "../globals/Theme.slint";
import { JsonUI } from "../globals/JsonUI.slint";
import { AppButton, Label, HLine } from "../components/Controls.slint";

export component JsonToolView inherits Rectangle {
    in-out property <int> view-index <=> JsonUI.view-mode;
    changed view-index => { JsonUI.view-changed(self.view-index); }

    function kind-color(t: string) -> color {
        if (t == "对象" || t == "数组") { return Theme.accent; }
        if (t == "字符串") { return Theme.ok; }
        if (t == "数字") { return Theme.info; }
        if (t == "布尔") { return Theme.warn; }
        return Theme.text-secondary;
    }

    background: Theme.content-bg;

    VerticalLayout {
        spacing: 0;

        // 工具栏
        Rectangle {
            height: 46px;

            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: 8px;
                cross-axis-alignment: center;

                AppButton { label: "格式化"; clicked => { JsonUI.format(); } }
                AppButton { label: "压缩"; clicked => { JsonUI.compress(); } }

                Rectangle { width: 1px; height: 20px; background: Theme.divider; }

                AppButton {
                    label: JsonUI.sort-desc ? "降序" : "升序";
                    clicked => { if (JsonUI.sort-desc) { JsonUI.sort-desc-btn(); } else { JsonUI.sort-asc(); } }
                }
                AppButton {
                    label: JsonUI.sort-recursive ? "递归" : "仅顶层";
                    kind: 3;
                    clicked => { JsonUI.sort-recursive = !JsonUI.sort-recursive; }
                }
                AppButton {
                    label: JsonUI.indent-mode == 0 ? "缩进 2 空格" : (JsonUI.indent-mode == 1 ? "缩进 4 空格" : "缩进 Tab");
                    kind: 3;
                    clicked => { JsonUI.indent-cycled(); }
                }

                Rectangle { horizontal-stretch: 1; }

                AppButton { label: "复制全部"; icon: "\u{E8C8}"; clicked => { JsonUI.copy-all(); } }
            }
        }

        HLine {}

        // 主体：文本 / 树形 双视图
        TabWidget {
            vertical-stretch: 1;
            current-index <=> root.view-index;

            Tab {
                title: "文本";
                TextEdit {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    height: parent.height - 12px;
                    text <=> JsonUI.text;
                    font-family: "Consolas";
                    font-size: Theme.fs-body;
                    wrap: no-wrap;
                    edited(t) => { JsonUI.text-edited(t); }
                }
            }

            Tab {
                title: "树形";
                ListView {
                    width: parent.width;
                    height: parent.height;

                    for n[index] in JsonUI.tree: Rectangle {
                        height: 28px;
                        background: node-ta.has-hover ? Theme.hover : transparent;

                        node-ta := TouchArea {
                            clicked => {
                                if (n.has-children) { JsonUI.tree-toggled(index); }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px + n.depth * 18px;
                            padding-right: 12px;
                            spacing: 7px;
                            cross-axis-alignment: center;

                            Text {
                                width: 12px;
                                text: n.expanded ? "\u{E70D}" : "\u{E76C}";
                                color: Theme.text-tertiary;
                                font-family: "Segoe MDL2 Assets";
                                font-size: Theme.fs-caption;
                                visible: n.has-children;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }

                            Label {
                                text: n.key == "" ? "(根)" : n.key;
                                mono: true;
                                size: Theme.fs-small;
                                horizontal-stretch: 0;
                            }

                            Rectangle {
                                width: 40px;
                                height: 18px;
                                border-radius: Theme.radius;
                                background: Theme.field-bg;

                                Text {
                                    text: n.kind;
                                    font-size: Theme.fs-caption;
                                    color: kind-color(n.kind);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Label {
                                text: n.preview;
                                mono: true;
                                size: Theme.fs-small;
                                role: 1;
                                horizontal-stretch: 1;
                            }

                            if n.has-children: Text {
                                text: "\{n.child-count} 项";
                                color: Theme.text-tertiary;
                                font-size: Theme.fs-caption;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // 状态栏（绝对定位，始终可见）
    Rectangle {
        y: parent.height - 26px;
        width: parent.width;
        height: 26px;
        background: Theme.surface;

        HLine {}

        HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            spacing: 12px;
            cross-axis-alignment: center;

            Text {
                text: JsonUI.text == "" ? "空文档 · 粘贴或输入 JSON 开始"
                    : (JsonUI.valid ? JsonUI.stats-line
                    : "第 \{JsonUI.error-line} 行 第 \{JsonUI.error-col} 列：\{JsonUI.error-msg}");
                color: JsonUI.text == "" ? Theme.text-tertiary : (JsonUI.valid ? Theme.text-secondary : Theme.danger);
                font-size: Theme.fs-caption;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Text {
                text: JsonUI.status;
                color: Theme.ok;
                font-size: Theme.fs-caption;
                vertical-alignment: center;
            }
        }
    }
}
