// SFTP 工具视图：左右双文件面板 + 传输 HUD + 连接选择浮层。
import { ListView, LineEdit } from "std-widgets.slint";
import { Theme } from "../globals/Theme.slint";
import { SftpUI, SftpRow } from "../globals/SftpUI.slint";
import { SshTreeNode } from "../globals/SshUI.slint";

component Panel inherits Rectangle {
    in property <int> side;             // 1 左 2 右
    in property <string> label;
    in property <string> path;
    in property <[SftpRow]> rows;
    in property <bool> connected;
    callback path-edited(string);

    background: Theme.card-bg;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.divider;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // 头部
        Rectangle {
            height: 30px;
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    y: 11px;
                    border-radius: 4px;
                    background: root.connected ? Theme.ok : Theme.divider;
                }
                Text {
                    text: root.label == "" ? (root.side == 1 ? "左：未连接" : "右：未连接") : root.label;
                    color: Theme.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Rectangle {
                    width: 60px;
                    Text { text: "连接…"; color: Theme.accent; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { SftpUI.open-picker(root.side); } }
                }
                Rectangle {
                    width: 44px;
                    Text { text: "断开"; color: Theme.danger; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { SftpUI.disconnect(root.side); } }
                }
            }
        }

        // 路径栏
        Rectangle {
            height: 30px;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 56px;
                    Text { text: "上级"; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { SftpUI.go-up(root.side); } }
                }
                LineEdit {
                    horizontal-stretch: 1;
                    text: root.path;
                    font-size: 12px;
                    accepted(t) => { root.path-edited(t); }
                }
                Rectangle {
                    width: 48px;
                    Text { text: "刷新"; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { SftpUI.refresh(root.side); } }
                }
            }
        }

        // 文件列表
        ListView {
            for r[index] in root.rows: Rectangle {
                height: 30px;
                border-radius: 5px;
                background: r.selected ? Theme.accent-soft : (ta.has-hover ? Theme.hover : transparent);

                ta := TouchArea {
                    clicked => {
                        SftpUI.row-toggled(root.side, index);
                    }
                    // 双击进入目录（简化：单击选中，工具栏进入按钮）
                }

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 8px;

                    Text {
                        width: 18px;
                        text: r.selected ? "☑" : "☐";
                        color: r.selected ? Theme.accent : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    Text {
                        width: 18px;
                        text: r.is-dir ? "📁" : "📄";
                        vertical-alignment: center;
                    }
                    Text {
                        text: r.name;
                        color: Theme.text;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: r.size-text;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        width: 76px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 操作条
        Rectangle {
            height: 30px;
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 84px;
                    Text { text: "进入目录"; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { SftpUI.row-activated(root.side, -2); } }
                }
                Rectangle {
                    width: 96px;
                    Text { text: "新建文件夹"; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { SftpUI.new-folder(root.side); } }
                }
                Rectangle {
                    width: 72px;
                    Text { text: "删除"; color: Theme.danger; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { SftpUI.delete-selected(root.side); } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}

export component SftpToolView inherits Rectangle {
    background: Theme.content-bg;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;

        Panel {
            side: 1;
            label: SftpUI.left-label;
            path: SftpUI.left-path;
            rows: SftpUI.left-rows;
            connected: SftpUI.left-connected;
            path-edited(t) => { SftpUI.path-edited(1, t); }
            horizontal-stretch: 1;
        }

        // 中间传输操作
        VerticalLayout {
            width: 96px;
            spacing: 10px;
            alignment: center;

            Rectangle {
                height: 60px;
                border-radius: 8px;
                background: ta1.has-hover ? Theme.hover : Theme.card-bg;
                border-width: 1px;
                border-color: Theme.accent;
                ta1 := TouchArea { clicked => { SftpUI.transfer(1); } }
                VerticalLayout {
                    alignment: center;
                    Text { text: "→"; font-size: 20px; color: Theme.accent; horizontal-alignment: center; }
                    Text { text: "传输到右"; font-size: 11px; color: Theme.text-secondary; horizontal-alignment: center; }
                }
            }

            Rectangle {
                height: 60px;
                border-radius: 8px;
                background: ta2.has-hover ? Theme.hover : Theme.card-bg;
                border-width: 1px;
                border-color: Theme.accent;
                ta2 := TouchArea { clicked => { SftpUI.transfer(2); } }
                VerticalLayout {
                    alignment: center;
                    Text { text: "←"; font-size: 20px; color: Theme.accent; horizontal-alignment: center; }
                    Text { text: "传输到左"; font-size: 11px; color: Theme.text-secondary; horizontal-alignment: center; }
                }
            }
        }

        Panel {
            side: 2;
            label: SftpUI.right-label;
            path: SftpUI.right-path;
            rows: SftpUI.right-rows;
            connected: SftpUI.right-connected;
            path-edited(t) => { SftpUI.path-edited(2, t); }
            horizontal-stretch: 1;
        }
    }

    // ===== 连接选择浮层 =====
    if SftpUI.picker-side > 0: Rectangle {
        background: rgba(0, 0, 0, 0.35);

        Rectangle {
            width: 460px;
            height: 420px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Theme.content-bg;
            border-width: 1px;
            border-color: Theme.divider;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    Text {
                        text: SftpUI.picker-side == 1 ? "连接到左侧面板" : "连接到右侧面板";
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.text;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 30px;
                        Text { text: "✕"; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { SftpUI.close-picker(); } }
                    }
                }

                Rectangle {
                    height: 34px;
                    Text { text: "连接本机"; color: Theme.accent; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { SftpUI.connect-local(SftpUI.picker-side); } }
                }

                ListView {
                    for n[index] in SftpUI.picker-profiles: Rectangle {
                        height: 38px;
                        background: tap.has-hover ? Theme.hover : transparent;
                        tap := TouchArea {
                            clicked => {
                                if (!n.is-folder) { SftpUI.connect-profile(SftpUI.picker-side, n.id); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px + n.depth * 18px;
                            spacing: 8px;
                            Text { width: 18px; text: n.is-folder ? "📁" : "🖥"; vertical-alignment: center; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text { text: n.name; color: Theme.text; font-size: 12px; overflow: elide; }
                                if !n.is-folder: Text { text: n.summary; color: Theme.text-secondary; font-size: 10px; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===== 传输 HUD =====
    if SftpUI.hud-visible: Rectangle {
        x: 16px;
        y: parent.height - 96px;
        width: parent.width - 32px;
        height: 80px;
        border-radius: 10px;
        background: Theme.sidebar-bg;
        border-width: 1px;
        border-color: Theme.divider;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: SftpUI.hud-line1;
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Rectangle {
                    width: 52px;
                    Text { text: "取消"; color: Theme.danger; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { SftpUI.cancel-transfer(); } }
                }
            }
            Text {
                text: SftpUI.hud-line2;
                color: Theme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.divider;
                Rectangle {
                    x: 0;
                    width: Math.max(4px, parent.width * Math.min(1.0, Math.max(0.0, SftpUI.hud-progress)));
                    border-radius: 3px;
                    background: Theme.accent;
                }
            }
            Text {
                text: SftpUI.hud-error;
                color: Theme.danger;
                font-size: 11px;
                visible: SftpUI.hud-error != "";
            }
        }
    }
}
