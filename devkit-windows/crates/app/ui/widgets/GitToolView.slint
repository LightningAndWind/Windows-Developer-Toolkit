// Git 工具视图：仓库登记 → 横幅 + 四组变更 + diff + 提交栏 + 分支/Stash/历史。
import { ListView, LineEdit, CheckBox } from "std-widgets.slint";
import { Theme } from "../globals/Theme.slint";
import { GitUI, GitChangeRow, GitCommitRow, GitBranchRow, GitStashRow, GitDiffRow, GitRepoNode, GitKeyRow } from "../globals/GitUI.slint";

component GButton inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    in property <bool> danger: false;
    in property <bool> disabled: false;
    callback clicked;
    height: 26px;
    min-width: 48px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 6px;
    opacity: disabled ? 0.45 : 1.0;
    background: ta.has-hover && !disabled ? (danger ? Theme.danger : Theme.hover) : (on ? Theme.accent-soft : transparent);
    border-width: 1px;
    border-color: on ? Theme.accent : Theme.divider;
    ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { if (!root.disabled) { root.clicked(); } } }
    Text {
        text: root.label;
        font-size: 12px;
        color: danger ? Theme.danger : (on ? Theme.accent : Theme.text);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ListSection inherits Rectangle {
    in property <string> title;
    in property <[GitChangeRow]> rows;
    in property <int> section;
    in property <bool> unpushed-mode: false;
    in property <[GitCommitRow]> commit-rows;
    callback selected(int, int);
    horizontal-stretch: 1;

    VerticalLayout {
        Rectangle {
            height: 22px;
            HorizontalLayout {
                padding-left: 6px;
                Text { text: root.title; color: Theme.text-secondary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
            }
        }
        if !root.unpushed-mode: ListView {
            for r[index] in root.rows: Rectangle {
                height: 26px;
                background: GitUI.selected-list == root.section && GitUI.selected-index == index ? Theme.accent-soft : (row-tap.has-hover ? Theme.hover : transparent);
                row-tap := TouchArea { clicked => { root.selected(root.section, index); } }
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 6px;
                    Text { text: r.untracked ? "?" : r.status; width: 22px; color: r.untracked ? Theme.warn : Theme.text-secondary; font-family: "Consolas"; font-size: 11px; vertical-alignment: center; }
                    Text { text: r.path; color: Theme.text; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    GButton { label: "＋"; width: 24px; clicked => { GitUI.stage(root.section, index); } }
                    GButton { label: "－"; width: 24px; clicked => { GitUI.unstage(root.section, index); } }
                    GButton { label: "✕"; width: 24px; danger: true; clicked => { GitUI.discard(root.section, index); } }
                }
            }
        }
        if root.unpushed-mode: ListView {
            for c[index] in root.commit-rows: Rectangle {
                height: 26px;
                background: commit-tap.has-hover ? Theme.hover : transparent;
                commit-tap := TouchArea { clicked => { GitUI.history-menu(index, 4); } }
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 6px;
                    Text { text: c.short; width: 54px; color: Theme.accent; font-family: "Consolas"; font-size: 11px; vertical-alignment: center; }
                    Text { text: c.subject; color: Theme.text; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
        }
    }
}

export component GitToolView inherits Rectangle {
    background: Theme.content-bg;

    // ===== 未打开仓库：登记列表 =====
    if !GitUI.repo-open: Rectangle {
        VerticalLayout {
            padding: 40px;
            spacing: 12px;

            Text { text: "Git 管理"; font-size: 20px; font-weight: 700; color: Theme.text; }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                GButton { label: "登记仓库…"; on: true; clicked => { GitUI.open-repo-path(); } }
                GButton { label: "克隆仓库…"; clicked => { GitUI.clone-start(); } }
                GButton { label: "密钥管理"; clicked => { GitUI.keys-open(); } }
            }

            ListView {
                for n[index] in GitUI.repos: Rectangle {
                    height: 40px;
                    background: repo-tap.has-hover ? Theme.hover : transparent;
                    repo-tap := TouchArea { clicked => { GitUI.repo-selected(index); } }
                    HorizontalLayout {
                        padding-left: 8px + n.depth * 18px;
                        spacing: 8px;
                        Text { width: 18px; text: n.is-folder ? "📁" : "🌿"; vertical-alignment: center; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: n.name; color: Theme.text; font-size: 13px; overflow: elide; }
                        }
                        Rectangle {
                            width: 26px;
                            Text { text: "✕"; color: Theme.danger; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { GitUI.repo-deleted(index); } }
                        }
                    }
                }
            }
        }
    }

    // ===== 已打开仓库 =====
    if GitUI.repo-open: Rectangle {
        VerticalLayout {
            // 横幅
            Rectangle {
                height: 56px;
                background: Theme.sidebar-bg;
                VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { text: GitUI.banner-branch; color: Theme.text; font-family: "Consolas"; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                        Text { text: "↑\{GitUI.ahead} ↓\{GitUI.behind}"; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
                        if GitUI.conflict-count > 0: Text { text: "⚠ 冲突 \{GitUI.conflict-count}"; color: Theme.warn; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                        if GitUI.rebasing: Text { text: "变基中"; color: Theme.warn; font-size: 12px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        GButton { label: "刷新"; clicked => { GitUI.refresh-all(); } }
                        GButton { label: "拉取"; disabled: GitUI.busy; clicked => { GitUI.pull(); } }
                        GButton { label: "推送"; disabled: GitUI.busy; clicked => { GitUI.push(); } }
                        GButton { label: "拉取+推送"; disabled: GitUI.busy; clicked => { GitUI.pull-push(); } }
                        GButton { label: "Fetch"; disabled: GitUI.busy; clicked => { GitUI.fetch(); } }
                        GButton { label: "关闭"; danger: true; clicked => { GitUI.close-repo(); } }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text { text: GitUI.remote-url == "" ? "（无远程）" : GitUI.remote-url; color: Theme.text-secondary; font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: GitUI.bound-key-name == "" ? "未绑定密钥" : "密钥：\{GitUI.bound-key-name}"; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0;

                // 左：变更四组 + 提交栏
                Rectangle {
                    width: 300px;

                    VerticalLayout {
                        Flickable {
                            Rectangle {
                                height: 460px;

                                VerticalLayout {
                                    ListSection {
                                        title: GitUI.conflict-count > 0 ? "冲突（置顶）" : "冲突";
                                        rows: GitUI.changes-conflict;
                                        section: 0;
                                        height: 86px;
                                        selected(i1, i2) => { GitUI.select-change(i1, i2); }
                                    }
                                    ListSection {
                                        title: "未暂存";
                                        rows: GitUI.changes-unstaged;
                                        section: 1;
                                        height: 108px;
                                        selected(i1, i2) => { GitUI.select-change(i1, i2); }
                                    }
                                    ListSection {
                                        title: "未提交（已暂存）";
                                        rows: GitUI.changes-staged;
                                        section: 2;
                                        height: 108px;
                                        selected(i1, i2) => { GitUI.select-change(i1, i2); }
                                    }
                                    ListSection {
                                        title: "未推送";
                                        unpushed-mode: true;
                                        commit-rows: GitUI.changes-unpushed;
                                        section: 3;
                                        height: 108px;
                                        selected(i1, i2) => { GitUI.select-change(i1, i2); }
                                    }
                                }
                            }
                        }

                        // 提交栏
                        Rectangle {
                            height: 96px;
                            background: Theme.sidebar-bg;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;
                                LineEdit {
                                    placeholder-text: "提交信息（Ctrl+Enter 提交）";
                                    text <=> GitUI.commit-message;
                                    font-size: 12px;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    CheckBox {
                                        text: "Amend";
                                        checked <=> GitUI.amend;
                                        font-size: 12px;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    GButton { label: "全部暂存"; clicked => { GitUI.stage-all(1); } }
                                    GButton { label: "全部取消"; clicked => { GitUI.unstage-all(2); } }
                                    GButton { label: "提交"; on: true; clicked => { GitUI.commit(); } }
                                }
                            }
                        }

                        // 分支 / Stash
                        Rectangle {
                            height: 150px;
                            HorizontalLayout {
                                spacing: 0;
                                VerticalLayout {
                                    width: 150px;
                                    Rectangle {
                                        height: 20px;
                                        Text { text: "分支"; color: Theme.text-secondary; font-size: 11px; x: 6px; }
                                    }
                                    Rectangle {
                                        height: 26px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            spacing: 4px;
                                            LineEdit { horizontal-stretch: 1; placeholder-text: "新分支名"; text <=> GitUI.new-branch-name; font-size: 11px; }
                                            GButton { label: "＋"; width: 22px; clicked => { GitUI.branch-new(); } }
                                        }
                                    }
                                    ListView {
                                        for b[index] in GitUI.branches: Rectangle {
                                            height: 24px;
                                            background: branch-tap.has-hover ? Theme.hover : transparent;
                                            branch-tap := TouchArea { clicked => { GitUI.branch-switch(index); } }
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                Text { text: b.current ? "●" : (b.remote ? "⇄" : "○"); width: 14px; color: b.current ? Theme.ok : Theme.text-secondary; font-size: 10px; vertical-alignment: center; }
                                                Text { text: b.name; color: Theme.text; font-size: 11px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                                GButton { label: "并"; width: 22px; clicked => { GitUI.merge-branch(index); } }
                                                GButton { label: "删"; width: 22px; danger: true; clicked => { GitUI.branch-delete(index, false); } }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        height: 20px;
                                        Text { text: "Stash"; color: Theme.text-secondary; font-size: 11px; x: 6px; }
                                    }
                                    Rectangle {
                                        height: 26px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            GButton { label: "暂存改动"; clicked => { GitUI.stash-push(); } }
                                        }
                                    }
                                    ListView {
                                        for s[index] in GitUI.stashes: Rectangle {
                                            height: 24px;
                                            background: stash-tap.has-hover ? Theme.hover : transparent;
                                            stash-tap := TouchArea { clicked => { GitUI.stash-pop(index); } }
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                Text { text: s.message; color: Theme.text; font-size: 11px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                                GButton { label: "Pop"; width: 34px; clicked => { GitUI.stash-pop(index); } }
                                                GButton { label: "✕"; width: 22px; danger: true; clicked => { GitUI.stash-drop(index); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 右：diff
                Rectangle {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        Rectangle {
                            height: 24px;
                            HorizontalLayout {
                                padding-left: 8px;
                                Text { text: GitUI.diff-path == "" ? "选择左侧文件查看差异" : GitUI.diff-path; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                if GitUI.diff-path != "" && GitUI.conflict-count > 0: HorizontalLayout {
                                    spacing: 4px;
                                    GButton { label: "保留我方"; clicked => { GitUI.conflict-ours(GitUI.selected-index); } }
                                    GButton { label: "保留对方"; clicked => { GitUI.conflict-theirs(GitUI.selected-index); } }
                                    GButton { label: "标记已解决"; on: true; clicked => { GitUI.conflict-resolved(GitUI.selected-index); } }
                                }
                                if GitUI.rebasing: GButton { label: "中止变基"; danger: true; clicked => { GitUI.rebase-abort(); } }
                            }
                        }
                        ListView {
                            for d in GitUI.diff: Rectangle {
                                height: 18px;
                                background: d.kind == 1 ? rgba(48, 209, 88, 0.10) : (d.kind == 2 ? rgba(255, 69, 58, 0.10) : (d.kind == 3 ? rgba(255, 159, 10, 0.12) : transparent));
                                HorizontalLayout {
                                    Text { text: d.left-no > 0 ? "\{d.left-no}" : ""; width: 40px; color: Theme.text-secondary; font-family: "Consolas"; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; }
                                    Text { text: d.right-no > 0 ? "\{d.right-no}" : ""; width: 40px; color: Theme.text-secondary; font-family: "Consolas"; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; }
                                    Text {
                                        text: d.text;
                                        color: d.kind == 1 ? Theme.ok : (d.kind == 2 ? Theme.danger : (d.kind == 3 ? Theme.warn : (d.kind == 4 ? Theme.text-secondary : Theme.text)));
                                        font-family: "Consolas";
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===== 输出控制台 / 密钥管理 / 克隆 对话框（简化合并为 console overlay） =====
    if GitUI.console-visible: Rectangle {
        background: rgba(0, 0, 0, 0.35);
        Rectangle {
            width: 640px;
            height: 420px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Theme.content-bg;
            border-width: 1px;
            border-color: Theme.divider;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    GButton { label: "登记路径仓库"; clicked => { GitUI.open-repo-path(); } }
                    GButton { label: "浏览…"; clicked => { GitUI.browse-repo-path(); } }
                    GButton { label: "生成密钥"; clicked => { GitUI.key-generate(); } }
                    GButton { label: "导入私钥"; clicked => { GitUI.key-import(); } }
                    Rectangle { horizontal-stretch: 1; }
                    GButton { label: "关闭"; clicked => { GitUI.close-repo(); } }
                }
                ListView {
                    for k[index] in GitUI.keys: Rectangle {
                        height: 30px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: k.name; color: Theme.text; font-size: 12px; width: 130px; vertical-alignment: center; overflow: elide; }
                            Text { text: k.algorithm; color: Theme.text-secondary; font-size: 11px; width: 60px; vertical-alignment: center; }
                            Text { text: k.fingerprint; color: Theme.text-secondary; font-family: "Consolas"; font-size: 10px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            GButton { label: "复制公钥"; clicked => { GitUI.key-copy-public(index); } }
                            GButton { label: "绑定"; on: k.bound; clicked => { GitUI.bind-key(index); } }
                            GButton { label: "删除"; danger: true; clicked => { GitUI.key-delete(index); } }
                        }
                    }
                }
            }
        }
    }

    // toast
    if GitUI.toast != "": Rectangle {
        x: parent.width / 2 - 160px;
        y: 16px;
        width: 320px;
        height: 34px;
        border-radius: 8px;
        background: GitUI.toast-kind == 0 ? rgba(48, 209, 88, 0.9) : rgba(255, 159, 10, 0.92);
        Text {
            text: GitUI.toast;
            color: #ffffff;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}
