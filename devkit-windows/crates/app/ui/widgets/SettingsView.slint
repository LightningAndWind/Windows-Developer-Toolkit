// 设置面板（M7）：通用 / HTTP 历史 / 终端会话 / Git 仓库 四分区。
import { ListView } from "std-widgets.slint";
import { Theme } from "../globals/Theme.slint";
import { AppState, SettingsRow } from "../globals/AppState.slint";

component Seg inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked;
    min-width: 64px;
    border-radius: 6px;
    background: on ? Theme.accent : (ta.has-hover ? Theme.hover : transparent);
    ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    Text {
        text: root.label;
        font-size: 12px;
        color: on ? #ffffff : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component GButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked;
    height: 26px;
    min-width: 48px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 6px;
    background: ta.has-hover ? (danger ? Theme.danger : Theme.hover) : Theme.active;
    ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    Text {
        text: root.label;
        font-size: 12px;
        color: danger ? #ffffff : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SettingsView inherits Rectangle {
    background: rgba(0, 0, 0, 0.35);

    Rectangle {
        width: 660px;
        height: 480px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 12px;
        background: Theme.content-bg;
        border-width: 1px;
        border-color: Theme.divider;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "设置";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                GButton { label: "完成"; clicked => { AppState.settings-closed(); } }
            }

            HorizontalLayout {
                spacing: 4px;
                alignment: start;

                Seg { label: "通用"; on: AppState.settings-tab == 0; clicked => { AppState.settings-tab-changed(0); } }
                Seg { label: "HTTP 历史"; on: AppState.settings-tab == 1; clicked => { AppState.settings-tab-changed(1); } }
                Seg { label: "终端会话"; on: AppState.settings-tab == 2; clicked => { AppState.settings-tab-changed(2); } }
                Seg { label: "Git 仓库"; on: AppState.settings-tab == 3; clicked => { AppState.settings-tab-changed(3); } }
            }

            // 通用
            if AppState.settings-tab == 0: VerticalLayout {
                spacing: 10px;

                Rectangle {
                    height: 56px;
                    border-radius: 8px;
                    background: Theme.sidebar-bg;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        Text { text: "数据目录"; color: Theme.text-secondary; font-size: 11px; }
                        Text { text: AppState.data-dir-path; color: Theme.text; font-size: 12px; overflow: elide; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    GButton { label: "在资源管理器中打开"; clicked => { AppState.open-data-dir(); } }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "外观："; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; }
                    Seg { label: "跟随系统"; on: AppState.appearance-mode == 0; clicked => { AppState.set-appearance(0); } }
                    Seg { label: "浅色"; on: AppState.appearance-mode == 1; clicked => { AppState.set-appearance(1); } }
                    Seg { label: "深色"; on: AppState.appearance-mode == 2; clicked => { AppState.set-appearance(2); } }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "防止锁屏："; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; }
                    Seg {
                        label: AppState.prevent-sleep ? "已开启" : "已关闭";
                        on: AppState.prevent-sleep;
                        clicked => { AppState.sleep-toggled(); }
                    }
                }

                Text {
                    text: AppState.settings-summary;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                }
            }

            // 列表分区（HTTP 历史 / 终端会话 / Git 仓库）
            if AppState.settings-tab > 0: VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: AppState.settings-summary;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if AppState.settings-tab == 1: GButton {
                        label: "清空全部历史";
                        danger: true;
                        clicked => { AppState.settings-history-cleared(); }
                    }
                }

                ListView {
                    for r[index] in AppState.settings-rows: Rectangle {
                        height: 36px;
                        background: row-tap.has-hover ? Theme.hover : transparent;
                        row-tap := TouchArea { clicked => { } }
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Text { text: r.title; color: Theme.text; font-size: 12px; overflow: elide; }
                                Text { text: r.subtitle; color: Theme.text-secondary; font-size: 10px; overflow: elide; }
                            }
                            Rectangle {
                                width: 40px;
                                Text { text: "删除"; color: Theme.danger; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { AppState.settings-row-deleted(r.id); } }
                            }
                        }
                    }
                }
            }
        }
    }
}
