// SFTP 工具视图：左右双文件面板 + 中间传输按钮 + 传输进度 + 连接选择浮层。
import { ListView, LineEdit } from "std-widgets.slint";
import { Theme } from "../globals/Theme.slint";
import { SftpUI, SftpRow } from "../globals/SftpUI.slint";
import { SshTreeNode } from "../globals/SshUI.slint";
import { AppButton, AppIconButton, Label, HLine, SectionHeader, Panel, EmptyState } from "../components/Controls.slint";

component FilePanel inherits Rectangle {
    in property <int> side;
    in property <string> label;
    in-out property <string> path;
    in property <[SftpRow]> rows;
    in property <bool> connected;
    callback path-edited(string);

    border-radius: Theme.radius;
    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    VerticalLayout {
        spacing: 0;

        // 头部
        Rectangle {
            height: 40px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.connected ? Theme.ok : transparent;
                    border-width: root.connected ? 0px : 1px;
                    border-color: Theme.text-tertiary;
                }

                Label {
                    text: root.label == "" ? (root.side == 1 ? "左侧面板" : "右侧面板") : root.label;
                    size: Theme.fs-small;
                    strong: true;
                    horizontal-stretch: 1;
                }

                AppButton {
                    label: root.connected ? "切换" : "连接";
                    btn-height: 26px;
                    clicked => { SftpUI.open-picker(root.side); }
                }

                if root.connected: AppIconButton {
                    icon: "\u{E711}";
                    box: 24px;
                    icon-size: 10px;
                    clicked => { SftpUI.disconnect(root.side); }
                }
            }
        }

        HLine {}

        // 路径栏
        Rectangle {
            height: 38px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                cross-axis-alignment: center;

                AppIconButton { icon: "\u{E70E}"; box: 26px; icon-size: 11px; clicked => { SftpUI.go-up(root.side); } }

                LineEdit {
                    horizontal-stretch: 1;
                    height: 26px;
                    // 双向绑定：用户手改过路径后绑定不会被打断，导航后路径栏仍会同步更新
                    text <=> root.path;
                    font-family: "Consolas";
                    font-size: Theme.fs-caption;
                    accepted(t) => { root.path-edited(t); }
                }

                AppIconButton { icon: "\u{E72C}"; box: 26px; icon-size: 12px; clicked => { SftpUI.refresh(root.side); } }
            }
        }

        HLine {}

        // 文件列表
        if root.connected: ListView {
            vertical-stretch: 1;

            for r[index] in root.rows: Rectangle {
                height: 30px;
                background: r.selected ? Theme.accent-soft : (ta.has-hover ? Theme.hover : transparent);

                ta := TouchArea {
                    clicked => { SftpUI.row-toggled(root.side, index); }
                    double-clicked => { SftpUI.row-activated(root.side, index); }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Text {
                        width: 14px;
                        text: r.selected ? "\u{E73E}" : "";
                        color: Theme.accent;
                        font-family: "Segoe MDL2 Assets";
                        font-size: Theme.fs-caption;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        width: 16px;
                        text: r.is-dir ? "\u{E8B7}" : "\u{E7C3}";
                        color: r.is-dir ? Theme.accent : Theme.text-tertiary;
                        font-family: "Segoe MDL2 Assets";
                        font-size: Theme.fs-small;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Label {
                        text: r.name;
                        size: Theme.fs-small;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: r.size-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.fs-caption;
                        width: 68px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if !root.connected: EmptyState {
            vertical-stretch: 1;
            icon: "\u{E8B7}";
            title: "未连接";
            hint: "点击右上角「连接」选择会话，或连接本机文件系统";
        }

        HLine {}

        // 操作条
        Rectangle {
            height: 38px;
            visible: root.connected;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                cross-axis-alignment: center;

                AppIconButton { icon: "\u{E76C}"; box: 26px; icon-size: 11px; clicked => { SftpUI.row-activated(root.side, -2); } }
                AppIconButton { icon: "\u{E8F4}"; box: 26px; icon-size: 12px; clicked => { SftpUI.new-folder(root.side); } }
                AppIconButton { icon: "\u{E74D}"; box: 26px; icon-size: 12px; clicked => { SftpUI.delete-selected(root.side); } }

                Rectangle { horizontal-stretch: 1; }

                AppButton {
                    label: "传输所选";
                    icon: root.side == 1 ? "\u{E76C}" : "\u{E76B}";
                    kind: 1;
                    btn-height: 26px;
                    clicked => { SftpUI.transfer(root.side); }
                }
            }
        }
    }
}

export component SftpToolView inherits Rectangle {
    background: Theme.content-bg;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;

        FilePanel {
            side: 1;
            label: SftpUI.left-label;
            path: SftpUI.left-path;
            rows: SftpUI.left-rows;
            connected: SftpUI.left-connected;
            path-edited(t) => { SftpUI.path-edited(1, t); }
            horizontal-stretch: 1;
        }

        // 中间传输列
        VerticalLayout {
            width: 104px;
            spacing: 8px;
            alignment: center;

            Rectangle {
                height: 56px;
                width: 92px;
                border-radius: Theme.radius;
                background: ta1.has-hover ? Theme.accent-soft : Theme.field-bg;
                border-width: 1px;
                border-color: ta1.has-hover ? Theme.accent : Theme.border;
                ta1 := TouchArea { clicked => { SftpUI.transfer(1); } }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text { text: "\u{E76C}"; font-family: "Segoe MDL2 Assets"; font-size: 15px; color: Theme.accent; horizontal-alignment: center; }
                    Text { text: "传送到右"; font-size: Theme.fs-caption; color: Theme.text-secondary; horizontal-alignment: center; wrap: no-wrap; overflow: elide; }
                }
            }

            Rectangle {
                height: 56px;
                width: 92px;
                border-radius: Theme.radius;
                background: ta2.has-hover ? Theme.accent-soft : Theme.field-bg;
                border-width: 1px;
                border-color: ta2.has-hover ? Theme.accent : Theme.border;
                ta2 := TouchArea { clicked => { SftpUI.transfer(2); } }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text { text: "\u{E76B}"; font-family: "Segoe MDL2 Assets"; font-size: 15px; color: Theme.accent; horizontal-alignment: center; }
                    Text { text: "传送到左"; font-size: Theme.fs-caption; color: Theme.text-secondary; horizontal-alignment: center; wrap: no-wrap; overflow: elide; }
                }
            }
        }

        FilePanel {
            side: 2;
            label: SftpUI.right-label;
            path: SftpUI.right-path;
            rows: SftpUI.right-rows;
            connected: SftpUI.right-connected;
            path-edited(t) => { SftpUI.path-edited(2, t); }
            horizontal-stretch: 1;
        }
    }

    // ===== 连接选择浮层 =====
    if SftpUI.picker-side > 0: Rectangle {
        background: rgba(0, 0, 0, 0.25);

        Panel {
            width: min(root.width - 48px, 440px);
            height: min(root.height - 48px, 420px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Text {
                        text: SftpUI.picker-side == 1 ? "连接到左侧面板" : "连接到右侧面板";
                        font-size: Theme.fs-title;
                        font-weight: 600;
                        color: Theme.text;
                        horizontal-stretch: 1;
                    }
                    AppIconButton { icon: "\u{E711}"; box: 24px; icon-size: 10px; clicked => { SftpUI.close-picker(); } }
                }

                AppButton {
                    label: "连接本机文件系统";
                    icon: "\u{E756}";
                    kind: 1;
                    horizontal-stretch: 1;
                    clicked => { SftpUI.connect-local(SftpUI.picker-side); }
                }

                SectionHeader { text: "已保存的 SSH 连接"; }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;

                    if SftpUI.picker-profiles.length == 0: EmptyState {
                        vertical-stretch: 1;
                        icon: "\u{E756}";
                        title: "还没有已保存的 SSH 连接";
                        hint: "先在「SSH 终端」工具中添加。";
                    }

                    if SftpUI.picker-profiles.length > 0: ListView {
                        vertical-stretch: 1;
                        for n[index] in SftpUI.picker-profiles: Rectangle {
                            height: 40px;
                            background: tap.has-hover && !n.is-folder ? Theme.hover : transparent;
                            tap := TouchArea {
                                clicked => {
                                    if (!n.is-folder) { SftpUI.connect-profile(SftpUI.picker-side, n.id); }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px + n.depth * 16px;
                                padding-right: 10px;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Text {
                                    width: 16px;
                                    text: n.is-folder ? "\u{E8B7}" : "\u{E756}";
                                    color: n.is-folder ? Theme.text-tertiary : Theme.accent;
                                    font-family: "Segoe MDL2 Assets";
                                    font-size: Theme.fs-small;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;
                                    Label { text: n.name; size: Theme.fs-small; }
                                    if !n.is-folder: Label { text: n.summary; size: Theme.fs-caption; role: 2; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===== 传输进度 =====
    if SftpUI.hud-visible: Panel {
        x: 16px;
        y: root.height - 108px;
        width: root.width - 32px;
        height: 92px;

        VerticalLayout {
            padding: 12px;
            spacing: 7px;

            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;
                Label {
                    text: SftpUI.hud-line1;
                    size: Theme.fs-small;
                    strong: true;
                    horizontal-stretch: 1;
                }
                AppButton { label: "取消"; kind: 2; btn-height: 24px; clicked => { SftpUI.cancel-transfer(); } }
            }

            Text {
                text: SftpUI.hud-line2;
                color: Theme.text-secondary;
                font-size: Theme.fs-caption;
                overflow: elide;
            }

            Rectangle {
                height: 5px;
                border-radius: 3px;
                background: Theme.field-bg;
                Rectangle {
                    x: 0;
                    width: Math.max(3px, parent.width * Math.min(1.0, Math.max(0.0, SftpUI.hud-progress)));
                    border-radius: 3px;
                    background: Theme.accent;
                }
            }

            if SftpUI.hud-error != "": Text {
                text: SftpUI.hud-error;
                color: Theme.danger;
                font-size: Theme.fs-caption;
            }
        }
    }
}
