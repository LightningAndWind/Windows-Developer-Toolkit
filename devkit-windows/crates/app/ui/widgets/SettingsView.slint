// 设置面板：通用 / HTTP 历史 / 终端会话 / Git 仓库 四分区。
import { ListView, TabWidget, ComboBox } from "std-widgets.slint";
import { Theme } from "../globals/Theme.slint";
import { AppState } from "../globals/AppState.slint";
import { AppButton, AppIconButton, Label, HLine, SectionHeader, Panel } from "../components/Controls.slint";

component SettingRow inherits Rectangle {
    in property <string> label;
    height: 32px;

    HorizontalLayout {
        spacing: 12px;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            width: 88px;
            color: Theme.text-secondary;
            font-size: Theme.fs-small;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }
        @children
        // 尾部占位：避免剩余空间全部分配给控件（Slint 在无人 stretch 时会平分剩余空间）
        Rectangle { horizontal-stretch: 1; }
    }
}

// 记录列表（HTTP 历史 / 终端会话 / Git 仓库 三个分区共用）
component SettingsList inherits Rectangle {
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;

    ListView {
        vertical-stretch: 1;
        for r[index] in AppState.settings-rows: Rectangle {
            height: 40px;
            background: row-tap.has-hover ? Theme.hover : transparent;
            row-tap := TouchArea { clicked => { } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                cross-axis-alignment: center;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    Label { text: r.title; size: Theme.fs-small; }
                    Label { text: r.subtitle; size: Theme.fs-caption; role: 2; }
                }
                AppIconButton { icon: "\u{E74D}"; box: 24px; icon-size: 11px; clicked => { AppState.settings-row-deleted(r.id); } }
            }
        }
    }
}

export component SettingsView inherits Rectangle {
    background: rgba(0, 0, 0, 0.25);

    Panel {
        width: min(root.width - 48px, 700px);
        height: min(root.height - 48px, 540px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        VerticalLayout {
            padding: 18px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;
                Text {
                    text: "设置";
                    font-size: Theme.fs-title;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
                AppButton { label: "完成"; kind: 1; clicked => { AppState.settings-closed(); } }
            }

            TabWidget {
                vertical-stretch: 1;
                current-index: AppState.settings-tab;

                // ===== 通用 =====
                Tab {
                    title: "通用";
                    Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-width: self.width;
                        content-height: body.preferred-height;

                        body := VerticalLayout {
                            width: parent.width;
                            spacing: 10px;

                            SectionHeader { text: "数据目录"; }

                            Rectangle {
                                height: 60px;
                                border-radius: Theme.radius;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;

                                VerticalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    spacing: 2px;
                                    Label { text: AppState.data-dir-path; size: Theme.fs-small; mono: true; }
                                    Label { text: "HTTP 历史、连接配置与 Git 登记都保存在此目录的 SQLite 数据库"; size: Theme.fs-caption; role: 2; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                AppButton { label: "在资源管理器中打开"; icon: "\u{E8B7}"; clicked => { AppState.open-data-dir(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            SectionHeader { text: "外观"; }

                            SettingRow { label: "主题";
                                ComboBox {
                                    width: 160px;
                                    height: 28px;
                                    model: ["跟随系统", "浅色", "深色"];
                                    current-index <=> AppState.appearance-mode;
                                    selected => { AppState.set-appearance(AppState.appearance-mode); }
                                }
                            }

                            SettingRow { label: "界面缩放";
                                ComboBox {
                                    width: 160px;
                                    height: 28px;
                                    model: ["跟随系统", "110%", "125%", "150%"];
                                    current-index <=> AppState.ui-scale;
                                    selected => { AppState.set-ui-scale(AppState.ui-scale); }
                                }
                                Label { text: "重启后生效"; size: Theme.fs-caption; role: 2; }
                            }

                            SettingRow { label: "防止锁屏";
                                AppButton {
                                    label: AppState.prevent-sleep ? "已开启 · 点击关闭" : "已关闭 · 点击开启";
                                    icon: "\u{E823}";
                                    kind: AppState.prevent-sleep ? 1 : 0;
                                    btn-height: 26px;
                                    clicked => { AppState.sleep-toggled(); }
                                }
                            }

                            SectionHeader { text: "运行工具"; }

                            Rectangle {
                                height: 84px;
                                border-radius: Theme.radius;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;

                                VerticalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    alignment: center;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        cross-axis-alignment: center;
                                        Text {
                                            text: AppState.git-missing ? "Git：未检测到（Git 工具需要）" : "Git：\{AppState.git-path}";
                                            color: AppState.git-missing ? Theme.warn : Theme.text-secondary;
                                            font-size: Theme.fs-caption;
                                            font-family: "Consolas";
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        if AppState.git-missing && !AppState.tools-installing: AppButton {
                                            label: "一键安装";
                                            btn-height: 24px;
                                            clicked => { AppState.install-tool(0); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        cross-axis-alignment: center;
                                        Text {
                                            text: AppState.ssh-missing ? "OpenSSH：未检测到（终端 / SFTP 需要）" : "OpenSSH：\{AppState.ssh-path}";
                                            color: AppState.ssh-missing ? Theme.warn : Theme.text-secondary;
                                            font-size: Theme.fs-caption;
                                            font-family: "Consolas";
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        if AppState.ssh-missing && !AppState.tools-installing: AppButton {
                                            label: "一键安装";
                                            btn-height: 24px;
                                            clicked => { AppState.install-tool(1); }
                                        }
                                    }
                                }
                            }

                            if AppState.tools-status != "": Label {
                                text: AppState.tools-status;
                                size: Theme.fs-small;
                                role: 1;
                            }

                            Label {
                                text: AppState.settings-summary;
                                size: Theme.fs-small;
                                role: 2;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 8px; }
                        }
                    }
                }

                // ===== 列表分区 =====
                Tab {
                    title: "HTTP 历史";
                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;
                            Label {
                                text: AppState.settings-summary;
                                size: Theme.fs-small;
                                role: 1;
                                horizontal-stretch: 1;
                            }
                            AppButton {
                                label: "清空全部历史";
                                kind: 2;
                                btn-height: 26px;
                                clicked => { AppState.settings-history-cleared(); }
                            }
                        }

                        SettingsList { vertical-stretch: 1; }
                    }
                }

                Tab {
                    title: "终端会话";
                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;
                            Label {
                                text: AppState.settings-summary;
                                size: Theme.fs-small;
                                role: 1;
                                horizontal-stretch: 1;
                            }
                        }

                        SettingsList { vertical-stretch: 1; }
                    }
                }

                Tab {
                    title: "Git 仓库";
                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;
                            Label {
                                text: AppState.settings-summary;
                                size: Theme.fs-small;
                                role: 1;
                                horizontal-stretch: 1;
                            }
                        }

                        SettingsList { vertical-stretch: 1; }
                    }
                }
            }
        }
    }
}
