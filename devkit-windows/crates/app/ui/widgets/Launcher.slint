// Launcher（新建标签页）：搜索框 + 按分类排列的工具卡片。
import { LineEdit } from "std-widgets.slint";
import { Theme } from "../globals/Theme.slint";
import { AppState, LauncherTool } from "../globals/AppState.slint";
import { Label, SectionHeader, HLine, Panel } from "../components/Controls.slint";

component ToolCard inherits Rectangle {
    in property <LauncherTool> tool;
    callback open();

    height: 66px;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    background: ta.has-hover ? Theme.hover : Theme.card-bg;

    ta := TouchArea {
        clicked => { root.open(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: Theme.radius-lg;
            background: Theme.accent-soft;

            Text {
                text: root.tool.icon;
                font-family: "Segoe MDL2 Assets";
                font-size: 18px;
                color: Theme.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.tool.title;
                font-size: Theme.fs-body;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }
            Text {
                text: root.tool.subtitle;
                font-size: Theme.fs-caption;
                color: Theme.text-secondary;
                vertical-alignment: center;
                wrap: word-wrap;
                max-height: 32px;
                // 限制副标题宽度：否则长副标题会把卡片撑宽，
                // 两列卡片在窄窗口下会溢出窗口右边（第二列点不到）。
                max-width: 360px;
            }
        }
    }
}

component ToolGroup inherits VerticalLayout {
    in property <string> title: "";
    in property <[LauncherTool]> tools;
    callback open(string);

    spacing: 6px;

    if root.title != "": SectionHeader { text: root.title; }

    GridLayout {
        spacing: 8px;
        for t in root.tools: ToolCard {
            tool: t;
            open => { root.open(t.id); }
        }
    }
}

export component Launcher inherits Rectangle {
    background: Theme.content-bg;

    callback open-tool(string);
    callback query-changed(string);

    Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: body.preferred-height;

        body := VerticalLayout {
            width: parent.width;
            padding-top: 48px;
            padding-bottom: 48px;
            padding-left: max(24px, (parent.width - 900px) / 2);
            padding-right: max(24px, (parent.width - 900px) / 2);
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                cross-axis-alignment: center;

                Text {
                    text: "\u{E90F}";
                    font-family: "Segoe MDL2 Assets";
                    font-size: 28px;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
                Text {
                    text: "新建标签";
                    font-size: 24px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }

            LineEdit {
                horizontal-stretch: 1;
                height: 34px;
                placeholder-text: "搜索工具…";
                font-size: Theme.fs-body;
                edited(t) => { root.query-changed(t); }
                accepted => { root.query-changed(self.text); }
            }

            if AppState.tools-network.length > 0: ToolGroup {
                title: "网络";
                tools: AppState.tools-network;
                open(id) => { root.open-tool(id); }
            }
            if AppState.tools-terminal.length > 0: ToolGroup {
                title: "终端";
                tools: AppState.tools-terminal;
                open(id) => { root.open-tool(id); }
            }
            if AppState.tools-data.length > 0: ToolGroup {
                title: "数据";
                tools: AppState.tools-data;
                open(id) => { root.open-tool(id); }
            }
            if AppState.tools-utility.length > 0: ToolGroup {
                title: "实用工具";
                tools: AppState.tools-utility;
                open(id) => { root.open-tool(id); }
            }

            if AppState.tools-network.length == 0 && AppState.tools-terminal.length == 0
                && AppState.tools-data.length == 0 && AppState.tools-utility.length == 0: Rectangle {
                height: 120px;
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Label { text: "没有匹配的工具"; role: 1; horizontal-alignment: center; }
                    Label { text: "换个关键词试试。"; role: 2; horizontal-alignment: center; }
                }
            }
        }
    }
}
