// SSH 工具视图：未连接时的会话选择 / 记录编辑；连接后为「连接横幅 + 终端」。
import { ListView, LineEdit, ComboBox } from "std-widgets.slint";
import { Theme } from "../globals/Theme.slint";
import { SshUI, SshTreeNode } from "../globals/SshUI.slint";
import { AppState } from "../globals/AppState.slint";
import { TerminalView } from "TerminalView.slint";
import { AppButton, AppIconButton, Label, HLine, SectionHeader, Panel, EmptyState } from "../components/Controls.slint";

component ProfileRow inherits Rectangle {
    in property <SshTreeNode> node;
    in property <int> index;
    height: 36px;
    border-radius: Theme.radius;
    background: row-ta.has-hover ? Theme.hover : transparent;

    row-ta := TouchArea {
        clicked => {
            if (node.is-folder) { SshUI.tree-toggled(index); } else { SshUI.tree-selected(index); }
        }
    }

    HorizontalLayout {
        padding-left: 8px + node.depth * 16px;
        padding-right: 8px;
        spacing: 8px;
        cross-axis-alignment: center;

        Text {
            width: 14px;
            text: node.is-folder ? (node.expanded ? "\u{E70D}" : "\u{E76C}") : "";
            color: Theme.text-tertiary;
            font-family: "Segoe MDL2 Assets";
            font-size: Theme.fs-caption;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            width: 18px;
            text: node.is-folder ? "\u{E8B7}" : (node.is-local ? "\u{E80F}" : "\u{E756}");
            font-family: "Segoe MDL2 Assets";
            font-size: Theme.fs-small;
            color: node.is-folder ? Theme.text-secondary : Theme.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Label {
            text: node.name;
            size: Theme.fs-small;
            horizontal-stretch: 1;
        }

        if !node.is-folder: Label {
            text: node.summary;
            size: Theme.fs-caption;
            role: 2;
            max-width: 260px;
        }

        if !node.is-folder: AppIconButton {
            icon: "\u{E70F}";
            box: 24px;
            icon-size: 11px;
            clicked => { SshUI.edit-record(index); }
        }

        AppIconButton {
            icon: "\u{E74D}";
            box: 24px;
            icon-size: 11px;
            clicked => { SshUI.tree-deleted(index); }
        }
    }
}

component FieldRow inherits Rectangle {
    in property <string> label;
    height: 32px;
    HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            width: 84px;
            color: Theme.text-secondary;
            font-size: Theme.fs-small;
            vertical-alignment: center;
        }
        @children
    }
}

export component SshToolView inherits Rectangle {
    background: Theme.content-bg;

    // ===== 已连接 / 连接中 / 失败：横幅 + 终端 =====
    if SshUI.state-kind != 0: VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // 连接横幅
        Rectangle {
            height: 38px;
            border-radius: Theme.radius;
            background: Theme.card-bg;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: SshUI.state-kind == 1
                        ? Theme.warn
                        : (SshUI.state-kind == 2 ? Theme.ok : Theme.danger);
                }

                Label {
                    text: SshUI.connect-summary == ""
                        ? SshUI.state-text
                        : "\{SshUI.connect-summary} · \{SshUI.state-text}";
                    size: Theme.fs-small;
                    horizontal-stretch: 1;
                    color: SshUI.state-kind == 2 ? Theme.text : (SshUI.state-kind == 1 ? Theme.text-secondary : Theme.danger);
                }

                if SshUI.connected: AppButton {
                    label: "断开";
                    btn-height: 26px;
                    clicked => { SshUI.disconnect(); }
                }

                if SshUI.state-kind == 3 || SshUI.state-kind == 4: AppButton {
                    label: "会话列表";
                    btn-height: 26px;
                    clicked => { SshUI.show-chooser(); }
                }

                if SshUI.state-kind == 3 || SshUI.state-kind == 4: AppButton {
                    label: "重新连接";
                    icon: "\u{E72C}";
                    kind: 1;
                    btn-height: 26px;
                    clicked => { SshUI.reconnect(); }
                }
            }
        }

        // 终端
        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius;
            background: Theme.terminal-bg;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            TerminalView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                term-bg: Theme.terminal-bg;
            }
        }
    }

    // ===== 未连接：会话选择面板 =====
    if SshUI.state-kind == 0 && !SshUI.editor-visible: VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 32px;
        padding-bottom: 24px;
        spacing: 12px;

        Text {
            text: "终端会话";
            font-size: 22px;
            font-weight: 600;
            color: Theme.text;
        }
        Label {
            text: "打开本地终端，或选择一个已保存的 SSH 连接。";
            role: 1;
            size: Theme.fs-small;
        }

        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;

            AppButton { label: "本地终端"; icon: "\u{E756}"; kind: 1; clicked => { SshUI.connect-local(); } }
            AppButton { label: "新建远程连接"; icon: "\u{E710}"; clicked => { SshUI.new-remote-record(); } }
            AppButton { label: "新建本地记录"; clicked => { SshUI.new-local-record(); } }
            Rectangle { horizontal-stretch: 1; }
        }

        // 缺失 OpenSSH 时的一键安装横幅
        if AppState.ssh-missing: Rectangle {
            height: 52px;
            border-radius: Theme.radius;
            background: Theme.warn-soft;
            border-width: 1px;
            border-color: Theme.warn;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 10px;
                cross-axis-alignment: center;

                Text {
                    text: "\u{E7BA}";
                    font-family: "Segoe MDL2 Assets";
                    font-size: 14px;
                    color: Theme.warn;
                    vertical-alignment: center;
                }

                Label {
                    text: "未检测到 OpenSSH，远程终端不可用（本地终端不受影响）。可一键安装便携版。";
                    size: Theme.fs-small;
                    horizontal-stretch: 1;
                    color: Theme.warn;
                }
                if !AppState.tools-installing: AppButton { label: "一键安装"; kind: 1; btn-height: 26px; clicked => { AppState.install-tool(1); } }
                if AppState.tools-installing: Label { text: AppState.tools-status; size: Theme.fs-small; role: 1; }
            }
        }

        // 会话记录列表
        Rectangle {
            vertical-stretch: 1;
            min-height: 200px;
            border-radius: Theme.radius;
            background: Theme.card-bg;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                spacing: 0;

                Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        cross-axis-alignment: center;
                        SectionHeader { text: "已保存的连接"; horizontal-stretch: 1; }
                        Label { text: "\{SshUI.profiles.length} 项"; size: Theme.fs-caption; role: 2; }
                    }
                }

                HLine {}

                if SshUI.profiles.length == 0: EmptyState {
                    vertical-stretch: 1;
                    icon: "\u{E756}";
                    title: "还没有保存的连接";
                    hint: "点击上方「新建远程连接」开始";
                }

                if SshUI.profiles.length > 0: ListView {
                    vertical-stretch: 1;
                    for n[index] in SshUI.profiles: ProfileRow {
                        node: n;
                        index: index;
                    }
                }
            }
        }
    }

    // ===== 记录编辑器 =====
    if SshUI.editor-visible: Rectangle {
        background: rgba(0, 0, 0, 0.25);

        Panel {
            width: min(root.width - 48px, 560px);
            height: min(root.height - 48px, 560px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;

                Text {
                    text: "编辑会话记录";
                    font-size: Theme.fs-title;
                    font-weight: 600;
                    color: Theme.text;
                }
                Label { text: "记录保存在本地数据库中，密码仅存储在本机。"; role: 2; size: Theme.fs-small; }

                Rectangle { height: 4px; }

                FieldRow { label: "类型";
                    ComboBox {
                        width: 160px;
                        height: 28px;
                        model: ["远程 SSH", "本地终端"];
                        current-index: SshUI.editing-local ? 1 : 0;
                        selected(v) => { SshUI.editor-kind-changed(v == "本地终端" ? 1 : 0); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                FieldRow { label: "名称";
                    LineEdit { horizontal-stretch: 1; height: 28px; text <=> SshUI.ed-name; font-size: Theme.fs-small; }
                }

                if SshUI.editing-local: FieldRow { label: "默认目录";
                    LineEdit { horizontal-stretch: 1; height: 28px; text <=> SshUI.ed-working-dir; placeholder-text: "留空 = 个人目录"; font-size: Theme.fs-small; }
                }

                if !SshUI.editing-local: VerticalLayout {
                    spacing: 10px;

                    FieldRow { label: "主机";
                        LineEdit { horizontal-stretch: 1; height: 28px; text <=> SshUI.ed-host; font-size: Theme.fs-small; }
                        Text { text: "端口"; width: 34px; color: Theme.text-secondary; font-size: Theme.fs-small; vertical-alignment: center; }
                        LineEdit { width: 78px; height: 28px; text <=> SshUI.ed-port; font-size: Theme.fs-small; }
                    }

                    FieldRow { label: "用户名";
                        LineEdit { horizontal-stretch: 1; height: 28px; text <=> SshUI.ed-user; font-size: Theme.fs-small; }
                    }

                    FieldRow { label: "认证方式";
                        ComboBox {
                            width: 140px;
                            height: 28px;
                            model: ["密码", "私钥"];
                            current-index <=> SshUI.ed-auth;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if SshUI.ed-auth == 0: FieldRow { label: "密码";
                        LineEdit { horizontal-stretch: 1; height: 28px; text <=> SshUI.ed-password; input-type: password; font-size: Theme.fs-small; }
                    }

                    if SshUI.ed-auth == 1: VerticalLayout {
                        spacing: 10px;
                        FieldRow { label: "私钥文件";
                            Label { text: SshUI.ed-key-file == "" ? "未选择" : SshUI.ed-key-file; size: Theme.fs-small; role: 1; horizontal-stretch: 1; }
                            AppButton { label: "选择…"; btn-height: 26px; clicked => { SshUI.pick-key-file(); } }
                        }
                        FieldRow { label: "口令";
                            LineEdit { horizontal-stretch: 1; height: 28px; text <=> SshUI.ed-passphrase; input-type: password; font-size: Theme.fs-small; }
                        }
                    }

                    FieldRow { label: "默认目录";
                        LineEdit { horizontal-stretch: 1; height: 28px; text <=> SshUI.ed-working-dir; placeholder-text: "远端路径，登录后自动 cd；留空不切换"; font-size: Theme.fs-small; }
                    }
                }

                if SshUI.editor-error != "": Label {
                    text: "\{SshUI.editor-error}";
                    color: Theme.danger;
                    size: Theme.fs-small;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Rectangle { horizontal-stretch: 1; }
                    AppButton { label: "取消"; clicked => { SshUI.cancel-editor(); } }
                    AppButton { label: "保存并连接"; kind: 1; clicked => { SshUI.save-record(); } }
                }
            }
        }
    }
}
